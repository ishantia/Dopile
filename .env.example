APP_NAME=Dopile
APP_ENV=production
HOST=0.0.0.0
PORT=8080

# Database
DATABASE_URL=sqlite:///./data/dopile.db

# Security & Secrets (Generate secure random values for production)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
CSRF_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_CSRF_SECRET_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Comma separated allowed origins if frontend is separate, otherwise leave empty for same-origin)
CORS_ORIGINS=

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# Host Restrictions (Set to false to allow logging in from other LAN devices)
HOST_ONLY_LOGIN=true
